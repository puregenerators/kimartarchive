# Copy to `.env.local` (preferred) or `.env`. Never commit real secrets.
# See docs/GOOGLE_SETUP.md, docs/DROPBOX_SETUP.md, and docs/SUBMISSION_PIPELINE.md

# Google Sheets (required in both Dropbox and Drive storage modes)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_spreadsheet_id

# Legacy Google Drive file storage only — required when ARTWORK_STORAGE_PROVIDER=drive.
# Optional (unused) when Dropbox is the artwork storage provider (default).
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_drive_folder_id

# Archive target: "production" (default) or "test"
# When "test", GOOGLE_TEST_SHEET_ID is required. Never falls back to production.
# GOOGLE_TEST_DRIVE_ROOT_FOLDER_ID is required only with ARTWORK_STORAGE_PROVIDER=drive.
ARTWORK_SUBMISSION_TARGET=production
GOOGLE_TEST_SHEET_ID=
GOOGLE_TEST_DRIVE_ROOT_FOLDER_ID=

# Dropbox OAuth (server-only — never NEXT_PUBLIC_)
# Create an App Folder app named "Kim Art Archive". See docs/DROPBOX_SETUP.md.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:3000/api/auth/dropbox/callback

# Vercel / production: set after connecting Dropbox locally (`.data/dropbox-credentials.json`).
# File storage does not persist on serverless; env is required for production.
# DROPBOX_REFRESH_TOKEN=
# DROPBOX_ACCOUNT_ID=
# DROPBOX_ACCOUNT_DISPLAY_NAME=
# DROPBOX_ACCOUNT_EMAIL=

# File storage backend for artwork submission (default: dropbox when unset).
# ARTWORK_STORAGE_PROVIDER=dropbox
# ARTWORK_STORAGE_PROVIDER=drive
# Unsupported values fail closed with a clear configuration error (no silent fallback).

# Development-only fault injection for controlled batch tests (ignored in production).
# ARTWORK_TEST_FAIL_OPERATION=upload_high_resolution
# ARTWORK_TEST_FAIL_INDEX=1

# Required for any hosted or local use. Missing in production fails closed
# (no public access). Never use NEXT_PUBLIC_ for this value.
APP_ACCESS_PASSWORD=
